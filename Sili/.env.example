# .env.example — SGQ Quimpac (Flask)
# Copiar a .env y completar con los valores reales. NUNCA commitear el .env real.
# Generado a partir de un grep real de os.getenv()/os.environ en modules/ y app.py.

# ==========================================================
# App / Flask
# ==========================================================
BITACORA_SECRET=                    # Secret key de Flask (firma de sesiones/cookies). Rotar si se filtró.
PORT=5000                           # Puerto del servidor Flask (default 5000)
FLASK_ENV=                          # development | production
FLASK_DEBUG=                        # 1 para activar debug (nunca en producción)
ENV=                                # Alternativa a FLASK_ENV usada en algunos checks de config.py
COOKIE_SECURE=                      # 1 para forzar cookie Secure aunque no se detecte X-Forwarded-Proto

# ==========================================================
# SQL Server (SGQ_BITACORA)
# ==========================================================
SQLSERVER_HOST=172.16.40.52         # IP/host del servidor SQL Server
SQLSERVER_PORT=1433
SQLSERVER_DATABASE=SGQ_BITACORA
SQLSERVER_USER=user_gqp             # Prod usa user_gqp — el default en código es user_sgp (ver CLAUDE.md)
SQLSERVER_PASSWORD=                 # NUNCA dejar el default hardcodeado del código en producción
SQLSERVER_DRIVER=SQL Server Native Client 11.0
SQLSERVER_ENCRYPT=yes               # Cambiar a "yes" en prod (default en código es "no" — ver auditoría §4)
SQLSERVER_TRUST_CERT=no             # Cambiar a "no" cuando el servidor tenga certificado válido instalado

# ==========================================================
# Microsoft Graph API (modules/email_to_task/graph_fetcher.py)
# ==========================================================
GRAPH_TENANT_ID=                    # Azure AD tenant id (app-only, client_credentials)
GRAPH_CLIENT_ID=                    # Azure AD app registration client id
GRAPH_CLIENT_SECRET=                # Azure AD client secret — rotar, quedó expuesto en el código antes
GRAPH_MAILBOX=jchavez@quimpac.com.ec       # Buzón que se lee vía Graph API
GRAPH_SOPORTE_ADDR=soporteti@quimpac.com.ec # Solo se procesan correos dirigidos a esta dirección

# ==========================================================
# IMAP (modules/email_to_task/email_fetcher.py — ruta alternativa, no usada en prod actualmente)
# ==========================================================
EMAIL_TICKET_IMAP_HOST=             # p.ej. imap.gmail.com
EMAIL_TICKET_IMAP_PORT=993
EMAIL_TICKET_USER=                  # Cuenta de correo IMAP
EMAIL_TICKET_PASS=                  # Contraseña o App Password
EMAIL_TICKET_FOLDER=INBOX
EMAIL_TICKET_MARK_SEEN=1            # 1 = marcar leído tras procesar

# ==========================================================
# SMTP (envío de correos del sistema)
# ==========================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ==========================================================
# WhatsApp Cloud API (modules/whatsapp/)
# ==========================================================
WHATSAPP_VERIFY_TOKEN=              # Token de verificación del webhook — NUNCA dejar el default "mi_token_seguro"
WHATSAPP_PHONE_NUMBER_ID=           # Phone Number ID de Meta
WHATSAPP_TOKEN=                     # Token de acceso a la Graph API de Meta
GRAPH_API_VERSION=v21.0             # Versión de la Graph API de Meta usada por WhatsApp

# ==========================================================
# Telegram (modules/telegram_utils.py) — planificador
# ==========================================================
TELEGRAM_BOT_TOKEN=                 # Fallback si no está configurado en BD (configuracion.telegram_bot_token)

# ==========================================================
# OpenAI (om_chat_service.py, routes_reclamos.py, routes_tareas.py)
# 🔴 om_chat_service.py ejecuta SQL dinámico desde la respuesta del modelo — ver auditoría §8
# ==========================================================
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ==========================================================
# SeedBilling — carga automática de XML de compras (modules/config.py)
# ==========================================================
SEEDBILLING_USUARIO=RECEPCION
SEEDBILLING_CLAVE=RECEPCION
SEEDBILLING_TOKEN=                  # El código trae un token de ejemplo hardcodeado como default — reemplazar
SEEDBILLING_SUSCRIPTOR=81
SEEDBILLING_TIPODOCUMENTO=01
SEEDBILLING_CANTIDAD=1000           # Comprobantes por ciclo de consulta
SEEDBILLING_MAX_LOOPS=10            # Máximo de ciclos por ejecución (10 x 1000 = hasta 10.000)
SEEDBILLING_TIMEOUT=180             # Timeout HTTP en segundos
SEEDBILLING_MARK_CHUNK_SIZE=100     # Comprobantes por request al marcar como entregados
SEEDBILLING_XML_ARCHIVE_FOLDER=     # Vacío = guarda en static/uploads/seedbilling_xml
SEEDBILLING_ADMIN_EMAILS=           # Correos adicionales separados por coma para alertas

# ==========================================================
# Otros
# ==========================================================
LOG_DIR=logs                        # Carpeta de logs rotativos (modules/app_core/app_logging.py)
EMAIL_POLL_INTERVAL=120             # Segundos entre ciclos del poller de email_to_task (default 120)
HASH_METHOD=scrypt                  # Método de hash de contraseñas (modules/auth/auth_security.py)
SOFFICE_BIN=                        # Ruta al binario de LibreOffice, usado por gastos_exports.py para exportar
